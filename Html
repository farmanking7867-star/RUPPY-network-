<script>
  // ========== APP STATE WITH LOCALSTORAGE ==========
  let userData = {
    userId: 'user_' + Math.random().toString(36).substr(2, 9),
    name: 'Akash Sharma',
    token: 1200,
    referralCode: '',
    referredBy: null,
    boostAdsWatched: 0,
    boostActive: false,
    boostEndTime: 0,
    lastMiningTime: Date.now() - (2 * 3600000),
    giftAdsWatched: 0,
    giftOpened: false,
    completedTasks: [],
    pendingTaskClaims: [],
    referrals: []
  };

  let allUsers = [];
  let currentUserId = localStorage.getItem('currentUserId');

  // Initialize or load data
  function init() {
    let storedUsers = localStorage.getItem('allUsers');
    if(storedUsers) {
      allUsers = JSON.parse(storedUsers);
    } else {
      // Create default users for demo
      allUsers = [
        { userId: 'user_1', name: 'Akash Sharma', token: 1200, referralCode: 'RUP123', referredBy: null, boostAdsWatched: 0, boostActive: false, boostEndTime: 0, lastMiningTime: Date.now() - 7200000, giftAdsWatched: 0, giftOpened: false, completedTasks: [], pendingTaskClaims: [], referrals: ['user_2', 'user_3', 'user_4', 'user_5', 'user_6', 'user_7', 'user_8', 'user_9', 'user_10', 'user_11', 'user_12'] },
        { userId: 'user_2', name: 'Rahul Verma', token: 800, referralCode: 'RAH456', referredBy: 'user_1', boostAdsWatched: 0, boostActive: false, boostEndTime: 0, lastMiningTime: Date.now() - 10000000, giftAdsWatched: 0, giftOpened: false, completedTasks: [], pendingTaskClaims: [], referrals: [] },
        { userId: 'user_3', name: 'Priya Singh', token: 950, referralCode: 'PRI789', referredBy: 'user_1', boostAdsWatched: 0, boostActive: false, boostEndTime: 0, lastMiningTime: Date.now() - 10000000, giftAdsWatched: 0, giftOpened: false, completedTasks: [], pendingTaskClaims: [], referrals: [] },
        { userId: 'user_4', name: 'Amit Patel', token: 600, referralCode: 'AMI321', referredBy: 'user_1', boostAdsWatched: 0, boostActive: false, boostEndTime: 0, lastMiningTime: Date.now() - 10000000, giftAdsWatched: 0, giftOpened: false, completedTasks: [], pendingTaskClaims: [], referrals: [] },
        { userId: 'user_5', name: 'Neha Gupta', token: 1100, referralCode: 'NEH654', referredBy: 'user_1', boostAdsWatched: 0, boostActive: false, boostEndTime: 0, lastMiningTime: Date.now() - 10000000, giftAdsWatched: 0, giftOpened: false, completedTasks: [], pendingTaskClaims: [], referrals: [] }
      ];
      // Add more dummy users
      for(let i=6; i<=12; i++) {
        allUsers.push({ userId: `user_${i}`, name: `User${i}`, token: Math.floor(Math.random() * 1000), referralCode: `REF${i}`, referredBy: 'user_1', boostAdsWatched: 0, boostActive: false, boostEndTime: 0, lastMiningTime: Date.now() - 10000000, giftAdsWatched: 0, giftOpened: false, completedTasks: [], pendingTaskClaims: [], referrals: [] });
      }
    }

    if(!currentUserId) {
      // Check URL for referral code
      const urlParams = new URLSearchParams(window.location.search);
      const refCode = urlParams.get('ref');
      
      if(refCode) {
        const referrer = allUsers.find(u => u.referralCode === refCode);
        if(referrer) {
          currentUserId = 'user_' + Math.random().toString(36).substr(2, 9);
          userData.userId = currentUserId;
          userData.referredBy = referrer.userId;
          userData.referralCode = generateReferralCode();
          // Add to referrer's referrals list
          referrer.referrals.push(currentUserId);
          // Give bonus to referrer
          referrer.token += 50;
          // Give bonus to new user
          userData.token = 100;
          saveAllUsers();
        } else {
          currentUserId = userData.userId;
          userData.referralCode = generateReferralCode();
        }
      } else {
        currentUserId = userData.userId;
        userData.referralCode = generateReferralCode();
      }
      
      // Check if user exists
      let existingUser = allUsers.find(u => u.userId === currentUserId);
      if(!existingUser) {
        allUsers.push(userData);
      } else {
        userData = existingUser;
      }
      localStorage.setItem('currentUserId', currentUserId);
    } else {
      let existingUser = allUsers.find(u => u.userId === currentUserId);
      if(existingUser) {
        userData = existingUser;
      } else {
        userData.userId = currentUserId;
        userData.referralCode = generateReferralCode();
        allUsers.push(userData);
      }
    }
    
    saveAllUsers();
    updateUI();
    startBoostCheck();
  }

  function generateReferralCode() {
    return 'RUP' + Math.random().toString(36).substr(2, 6).toUpperCase();
  }

  function saveAllUsers() {
    // Update current user in allUsers array
    const index = allUsers.findIndex(u => u.userId === userData.userId);
    if(index !== -1) {
      allUsers[index] = userData;
    } else {
      allUsers.push(userData);
    }
    localStorage.setItem('allUsers', JSON.stringify(allUsers));
  }

  // ========== AD SYSTEM ==========
  let pendingAdCallback = null;
  let adTimerInterval = null;

  function showAd(onComplete) {
    pendingAdCallback = onComplete;
    const adContainer = document.getElementById('adContainer');
    const adTimer = document.getElementById('adTimer');
    const closeBtn = document.getElementById('closeAdBtn');
    
    adContainer.classList.add('show');
    closeBtn.style.display = 'none';
    let timeLeft = 5;
    adTimer.innerText = timeLeft;
    
    adTimerInterval = setInterval(() => {
      timeLeft--;
      adTimer.innerText = timeLeft;
      if(timeLeft <= 0) {
        clearInterval(adTimerInterval);
        closeBtn.style.display = 'block';
        adTimer.innerText = '✓';
      }
    }, 1000);
    
    closeBtn.onclick = () => {
      clearInterval(adTimerInterval);
      adContainer.classList.remove('show');
      if(pendingAdCallback) {
        pendingAdCallback();
        pendingAdCallback = null;
      }
    };
  }

  // ========== REWARD CLAIM WITH AD ==========
  function claimRewardWithAd(rewardAmount, onSuccess) {
    showAd(() => {
      userData.token += rewardAmount;
      saveAllUsers();
      updateUI();
      if(onSuccess) onSuccess();
      alert(`🎉 +${rewardAmount} RUPPY earned!`);
    });
  }

  // ========== MINING WITH AD ==========
  document.getElementById('startMiningBtn').addEventListener('click', () => {
    let now = Date.now();
    let diff = now - userData.lastMiningTime;
    let hoursLeft = (4 * 3600000 - diff) / 3600000;
    
    if(diff >= 4 * 3600000) {
      let reward = 20;
      if(userData.boostActive) reward = 22;
      
      showAd(() => {
        userData.token += reward;
        userData.lastMiningTime = Date.now();
        saveAllUsers();
        updateUI();
        alert(`⛏️ Mined ${reward} RUPPY!`);
      });
    } else {
      let minutesLeft = Math.ceil((4 * 3600000 - diff) / 60000);
      alert(`⏳ Mining cooldown: ${minutesLeft} minutes remaining.`);
    }
  });

  // ========== BOOST WITH 3 ADS ==========
  document.getElementById('boostedMiningBtn').addEventListener('click', () => {
    if(userData.boostActive) {
      alert("Boost already active!");
      return;
    }
    
    if(userData.boostAdsWatched < 3) {
      let remaining = 3 - userData.boostAdsWatched;
      showAd(() => {
        userData.boostAdsWatched++;
        saveAllUsers();
        updateUI();
        if(userData.boostAdsWatched >= 3) {
          alert("🎉 You've watched 3 ads! Boost is now available. Click again to activate!");
        } else {
          alert(`✅ Ad watched! ${remaining-1} more ads for boost.`);
        }
        updateUI();
      });
    } else {
      // Activate boost
      userData.boostActive = true;
      userData.boostEndTime = Date.now() + 3600000;
      saveAllUsers();
      updateUI();
      alert("🔥 BOOST ACTIVATED! +10% mining speed for 1 hour.");
    }
  });

  // ========== GIFT BOX WITH 3 ADS ==========
  document.getElementById('watchAdBtn').addEventListener('click', () => {
    if(userData.giftOpened) {
      alert("Gift already claimed!");
      return;
    }
    
    if(userData.giftAdsWatched < 2) {
      showAd(() => {
        userData.giftAdsWatched++;
        saveAllUsers();
        updateUI();
        alert(`Ad watched! Progress: ${userData.giftAdsWatched}/3`);
      });
    } else if(userData.giftAdsWatched === 2) {
      showAd(() => {
        userData.giftAdsWatched = 3;
        userData.giftOpened = true;
        userData.token += 30;
        saveAllUsers();
        updateUI();
        alert("🎁 Golden Gift opened! +30 RUPPY TOKEN");
      });
    }
  });

  // ========== TASKS ==========
  const tasks = [
    { id: 'telegram', title: 'Join Telegram', reward: 20, link: 'https://t.me/RUPPYfoundation' },
    { id: 'facebook', title: 'Follow on Facebook', reward: 20, link: 'https://www.facebook.com/share/1GtEzhzQYv/' },
    { id: 'twitter', title: 'Follow on X', reward: 20, link: 'https://x.com/rupfoundation' }
  ];

  function renderTasks() {
    let container = document.getElementById('tasks-container');
    if(!container) return;
    container.innerHTML = '';
    
    tasks.forEach(task => {
      let isCompleted = userData.completedTasks.includes(task.id);
      let isPending = userData.pendingTaskClaims.includes(task.id);
      let btnText = isCompleted ? 'CLAIMED ✓' : (isPending ? 'CLAIM REWARD' : 'JOIN & CLAIM');
      let btnExtra = (!isCompleted && isPending) ? 'claim-active' : '';
      
      let taskDiv = document.createElement('div');
      taskDiv.className = 'task-card';
      taskDiv.innerHTML = `
        <div class="task-info">
          <h4>${task.title}</h4>
          <div class="task-reward">+${task.reward} RUPPY</div>
        </div>
        <button class="task-btn ${btnExtra}" data-task="${task.id}" ${isCompleted ? 'disabled' : ''}>${btnText}</button>
      `;
      container.appendChild(taskDiv);
    });
    
    document.querySelectorAll('.task-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        let taskId = btn.getAttribute('data-task');
        let task = tasks.find(t => t.id === taskId);
        
        if(userData.completedTasks.includes(taskId)) {
          alert("Task already completed!");
          return;
        }
        
        if(userData.pendingTaskClaims.includes(taskId)) {
          claimRewardWithAd(task.reward, () => {
            userData.completedTasks.push(taskId);
            userData.pendingTaskClaims = userData.pendingTaskClaims.filter(id => id !== taskId);
            saveAllUsers();
            renderTasks();
          });
        } else {
          window.open(task.link, '_blank');
          alert("Complete action, then come back. Claim button will be ready in 6 seconds.");
          userData.pendingTaskClaims.push(taskId);
          saveAllUsers();
          renderTasks();
          setTimeout(() => {
            if(!userData.completedTasks.includes(taskId) && userData.pendingTaskClaims.includes(taskId)) {
              renderTasks();
              alert("✅ Claim button enabled! Click CLAIM REWARD.");
            }
          }, 6000);
        }
      });
    });
  }

  // ========== LEADERBOARD (AUTO RANKING) ==========
  function getLeaderboard() {
    let usersWithReferrals = allUsers.map(u => ({
      name: u.name,
      referrals: u.referrals.length,
      userId: u.userId
    }));
    
    usersWithReferrals.sort((a, b) => b.referrals - a.referrals);
    
    let leaderboard = [];
    for(let i = 0; i < usersWithReferrals.length; i++) {
      let reward = 0;
      if(i === 0) reward = 1000;
      else if(i < 10) reward = 700;
      else if(i < 50) reward = 500;
      else reward = 100;
      
      leaderboard.push({
        rank: i + 1,
        name: usersWithReferrals[i].name,
        referrals: usersWithReferrals[i].referrals,
        reward: reward
      });
    }
    return leaderboard;
  }

  function renderLeaderboard() {
    let leaderboard = getLeaderboard();
    let html = `<div class="leader-row"><strong>Rank</strong><strong>User</strong><strong>Refs</strong><strong>Reward</strong></div>`;
    leaderboard.slice(0, 10).forEach(u => {
      let medal = u.rank === 1 ? '🥇' : (u.rank === 2 ? '🥈' : (u.rank === 3 ? '🥉' : `#${u.rank}`));
      html += `<div class="leader-row"><span>${medal}</span><span>${u.name}</span><span>${u.referrals}</span><span>${u.reward} RP</span></div>`;
    });
    document.getElementById('leaderboardList').innerHTML = html;
  }

  // ========== TEAM MANAGEMENT ==========
  function renderTeamList() {
    let referredUsers = allUsers.filter(u => u.referredBy === userData.userId);
    let html = '';
    referredUsers.forEach(m => {
      let isActive = (Date.now() - m.lastMiningTime) < 24 * 3600000;
      let statusClass = isActive ? 'status-green' : 'status-red';
      let statusText = isActive ? '🟢 Mining (Active)' : '⚪ Offline';
      html += `<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; background:#1a1a1a; padding:8px; border-radius:12px;">
        <div><i class="fas fa-user"></i> ${m.name}<br><span class="${statusClass}">${statusText}</span></div>
      </div>`;
    });
    document.getElementById('memberList').innerHTML = html || '<div>No team members yet. Share your referral code!</div>';
    
    let activeCount = referredUsers.filter(m => (Date.now() - m.lastMiningTime) < 24 * 3600000).length;
    let teamReward = activeCount * 8;
    document.getElementById('teamReward').innerText = teamReward;
  }

  // ========== UPDATE ALL UI ==========
  function updateUI() {
    // Update token displays
    document.querySelectorAll('.token-balance, #wallet-badge, #walletBalanceShow').forEach(el => {
      if(el) el.innerText = userData.token.toLocaleString();
    });
    
    let usdValue = (userData.token / 1200).toFixed(2);
    let inrValue = (usdValue * 84).toFixed(2);
    document.getElementById('usdValue').innerText = usdValue;
    document.getElementById('inrValue').innerText = inrValue;
    document.getElementById('walletUsdValue').innerText = usdValue;
    document.getElementById('profileInr').innerText = inrValue;
    document.getElementById('profileName').innerText = userData.name;
    document.getElementById('userName').innerText = userData.name;
    document.getElementById('referralCodeDisplay').innerText = userData.referralCode;
    
    // Boost status
    let boostPercent = userData.boostActive ? 10 : 0;
    let totalSpeed = userData.boostActive ? 1.10 : 1.00;
    document.getElementById('current-speed').innerHTML = `x${totalSpeed.toFixed(2)}`;
    document.getElementById('boostProgressText').innerHTML = `${userData.boostAdsWatched}/3 ads watched for boost`;
    
    // Gift status
    let giftStatus = userData.giftOpened ? "Gift Opened! +30 RP" : `${userData.giftAdsWatched}/3 watch ads to open`;
    document.getElementById('gift-status').innerText = giftStatus;
    
    // Team stats
    let referredUsers = allUsers.filter(u => u.referredBy === userData.userId);
    let activeCount = referredUsers.filter(m => (Date.now() - m.lastMiningTime) < 24 * 3600000).length;
    document.getElementById('team-count').innerText = referredUsers.length;
    document.getElementById('active-miners').innerText = activeCount;
    document.getElementById('teamTotal').innerText = referredUsers.length;
    document.getElementById('teamActive').innerText = activeCount;
    document.getElementById('teamInactive').innerText = referredUsers.length - activeCount;
    
    renderTeamList();
    renderLeaderboard();
    renderTasks();
  }

  function startBoostCheck() {
    setInterval(() => {
      if(userData.boostActive && Date.now() > userData.boostEndTime) {
        userData.boostActive = false;
        saveAllUsers();
        updateUI();
        alert("Boost expired! Watch 3 ads to activate again.");
      }
    }, 1000);
  }

  // ========== EVENT LISTENERS ==========
  document.getElementById('copyReferralBtn')?.addEventListener('click', () => {
    navigator.clipboard.writeText(userData.referralCode);
    alert(`Referral code ${userData.referralCode} copied! Share this link: ${window.location.origin}${window.location.pathname}?ref=${userData.referralCode}`);
  });
  
  document.getElementById('inviteFriendsBtn')?.addEventListener('click', () => {
    alert(`Share this link: ${window.location.origin}${window.location.pathname}?ref=${userData.referralCode}`);
  });
  
  document.getElementById('viewLeaderboardLink')?.addEventListener('click', (e) => {
    e.preventDefault();
    document.querySelector('[data-nav="team"]').click();
  });
  
  document.getElementById('addWalletBtn')?.addEventListener('click', () => alert("Add wallet feature coming soon!"));
  document.getElementById('withdrawDemoBtn')?.addEventListener('click', () => {
    if(userData.token >= 500) {
      alert(`Withdrawal initiated for ${userData.token} RUPPY (Demo)`);
    } else {
      alert(`Minimum 500 RUPPY required. You have ${userData.token} RUPPY.`);
    }
  });
  document.getElementById('logoutBtn')?.addEventListener('click', () => {
    localStorage.removeItem('currentUserId');
    location.reload();
  });
  
  document.querySelectorAll('.setting-item').forEach(el => {
    el.addEventListener('click', () => alert("Feature in development: " + el.innerText));
  });
  
  // Navigation
  const pages = { dashboard:'dashboard-page', team:'team-page', wallet:'wallet-page', profile:'profile-page' };
  document.querySelectorAll('.nav-item').forEach(nav => {
    nav.addEventListener('click', () => {
      let target = nav.getAttribute('data-nav');
      Object.values(pages).forEach(pid => document.getElementById(pid).classList.remove('active-page'));
      document.getElementById(pages[target]).classList.add('active-page');
      document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
      nav.classList.add('active');
    });
  });
  
  // Initialize
  init();
</script>
</body>
</html>
