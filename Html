  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background-color: #000000; font-family: 'Inter', sans-serif; color: #ffffff; padding-bottom: 80px; }
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: #1a1a1a; }
    ::-webkit-scrollbar-thumb { background: #D4AF37; border-radius: 10px; }
    .app-container { max-width: 500px; margin: 0 auto; background: #000000; min-height: 100vh; position: relative; }
    .gold-text { color: #D4AF37; font-weight: 700; }
    .premium-logo-area { text-align: center; padding: 24px 16px 12px; background: linear-gradient(135deg, #000000 0%, #0a0702 100%); border-bottom: 1px solid rgba(212, 175, 55, 0.3); }
    .coin-logo { width: 100px; margin: 0 auto; position: relative; }
    .gold-coin { background: radial-gradient(circle at 30% 30%, #f5e18b, #b47c2e); border-radius: 50%; width: 100px; height: 100px; margin: 0 auto; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 20px rgba(212,175,55,0.6); border: 2px solid #ffdf80; }
    .coin-inner { text-align: center; font-weight: 800; font-size: 48px; color: #ffd966; text-shadow: 2px 2px 0 #a35c00; }
    .phoenix-icon { font-size: 28px; margin: 0 6px; color: #ffaa33; }
    .flame-loop { position: absolute; width: 100%; height: 100%; border-radius: 50%; background: radial-gradient(circle, rgba(255,100,0,0.3) 0%, rgba(255,215,0,0) 80%); animation: rotateFlame 6s linear infinite; }
    @keyframes rotateFlame { 0% { transform: rotate(0deg);} 100% { transform: rotate(360deg);} }
    .app-name { font-size: 28px; font-weight: 800; background: linear-gradient(135deg, #F9D976, #E6B422); -webkit-background-clip: text; background-clip: text; color: transparent; margin-top: 8px; }
    .tagline { font-size: 12px; color: #aaa; margin-top: 6px; }
    .ticker { background: #111111; padding: 8px 12px; overflow: hidden; white-space: nowrap; font-size: 13px; color: #D4AF37; border-bottom: 1px solid #2a2a2a; }
    .ticker span { display: inline-block; animation: marquee 12s linear infinite; padding-right: 30px; }
    @keyframes marquee { 0% { transform: translateX(100%);} 100% { transform: translateX(-100%);} }
    .card { background: #111111; border-radius: 15px; padding: 16px; margin-bottom: 16px; box-shadow: 0 5px 12px rgba(0,0,0,0.5); border: 1px solid #222; }
    .gold-border { border: 1px solid rgba(212,175,55,0.4); }
    .balance-card { background: linear-gradient(145deg, #0f0f0f, #080808); }
    .token-balance { font-size: 42px; font-weight: 800; letter-spacing: -1px; }
    .usd-rate { font-size: 14px; color: #aaa; margin-top: 4px; }
    .btn-start-mining { background: linear-gradient(95deg, #D4AF37, #B8860B); border: none; width: 100%; padding: 20px; font-size: 24px; font-weight: 800; border-radius: 20px; color: #000; box-shadow: 0 6px 0 #7a4f00; transition: 0.08s linear; cursor: pointer; margin-bottom: 12px; }
    .btn-start-mining:active { transform: translateY(2px); box-shadow: 0 3px 0 #7a4f00; }
    .btn-boosted { background: #222; border: 1px solid #D4AF37; width: 100%; padding: 14px; font-size: 18px; font-weight: bold; border-radius: 20px; color: #D4AF37; cursor: pointer; margin-bottom: 8px; }
    .btn-boosted.disabled { opacity: 0.5; cursor: not-allowed; }
    .sub-text { font-size: 12px; color: #777; text-align: center; margin-top: 4px; }
    .gift-box { background: #1e1a0c; display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-radius: 60px; margin: 16px 0; border: 1px solid #D4AF37; }
    .gift-icon { font-size: 40px; }
    .claim-ad-btn { background: #D4AF37; border: none; padding: 8px 18px; border-radius: 40px; font-weight: bold; color: black; cursor: pointer; }
    .stats-row { display: flex; gap: 12px; margin-bottom: 16px; }
    .stat-card { background: #111; flex: 1; border-radius: 15px; padding: 12px; text-align: center; }
    .bottom-nav { position: fixed; bottom: 0; max-width: 500px; width: 100%; background: #0a0a0a; display: flex; justify-content: space-around; padding: 12px 16px; border-top: 1px solid #2a2a2a; z-index: 100; }
    .nav-item { text-align: center; color: #888; font-size: 12px; transition: 0.2s; cursor: pointer; }
    .nav-item.active { color: #D4AF37; }
    .nav-item i { font-size: 24px; display: block; margin-bottom: 2px; }
    .page { display: none; padding: 16px; animation: fade 0.2s ease; }
    .active-page { display: block; }
    @keyframes fade { from { opacity: 0; transform: translateY(6px);} to { opacity: 1; transform: translateY(0);} }
    .task-card { background: #111; border-radius: 20px; margin-bottom: 12px; padding: 12px; display: flex; align-items: center; justify-content: space-between; border-left: 4px solid #D4AF37; }
    .task-info h4 { font-size: 16px; }
    .task-reward { color: #D4AF37; font-weight: bold; }
    .task-btn { background: #2a2a2a; border: none; padding: 8px 14px; border-radius: 30px; color: white; font-size: 12px; cursor: pointer; }
    .task-btn.claim-active { background: #D4AF37; color: black; font-weight: bold; }
    .leader-row { display: flex; justify-content: space-between; background: #111; padding: 12px; border-radius: 12px; margin-bottom: 6px; }
    .status-green { color: #2ecc71; }
    .status-red { color: #e74c3c; }
    button { cursor: pointer; }
    .logout-btn { background: transparent; border: 1px solid #b33; color: #f66; padding: 14px; border-radius: 30px; width: 100%; font-weight: bold; margin-top: 20px; }
    .ad-container { background: #1a1a1a; padding: 10px; text-align: center; margin: 10px 0; border-radius: 10px; display: none; }
    .ad-container.show { display: block; }
    .ad-close { background: #D4AF37; color: black; border: none; padding: 5px 15px; border-radius: 20px; margin-top: 8px; cursor: pointer; }
  </style>
</head>
