<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RUPPY Network - Mining Center</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background-color: #000; color: #fff; font-family: sans-serif; overflow-x: hidden; }
        .gold-glow { box-shadow: 0 0 30px rgba(234, 179, 8, 0.4); }
        .mining-animate { animation: pulse 1.5s infinite; }
        @keyframes pulse { 0% { transform: scale(1); box-shadow: 0 0 20px rgba(234, 179, 8, 0.4); } 50% { transform: scale(1.05); box-shadow: 0 0 50px rgba(234, 179, 8, 0.7); } 100% { transform: scale(1); box-shadow: 0 0 20px rgba(234, 179, 8, 0.4); } }
    </style>
</head>
<body>
    <nav class="border-b border-yellow-500/20 p-5 flex justify-between items-center bg-black/90 sticky top-0 z-50">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-yellow-500 rounded-full flex items-center justify-center gold-glow">
                <span class="text-black font-black text-2xl">R</span>
            </div>
            <span class="text-3xl font-black text-yellow-500 tracking-tighter">RUPPY</span>
        </div>
        <button class="bg-yellow-500 text-black px-8 py-3 rounded-full font-black hover:bg-yellow-400 transition-all">CONNECT WALLET</button>
    </nav>

    <div class="max-w-4xl mx-auto px-6 pt-12 pb-20">
        <div class="bg-zinc-900 border-2 border-yellow-500/30 p-10 rounded-[2.5rem] text-center mb-12 shadow-2xl relative overflow-hidden">
            <div class="absolute top-0 right-0 p-4 opacity-10">
                <svg width="100" height="100" viewBox="0 0 24 24" fill="yellow"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <p class="text-yellow-500/60 font-bold uppercase tracking-[0.2em] text-sm mb-3">Your Mining Balance</p>
            <h2 id="balance" class="text-6xl md:text-7xl font-black text-white tracking-tighter">1,250.45 <span class="text-yellow-500">R</span></h2>
        </div>

        <div class="flex flex-col items-center gap-10">
            <div id="miningBtn" onclick="toggleMining()" class="w-72 h-72 rounded-full bg-zinc-900 border-[10px] border-zinc-800 flex flex-col items-center justify-center gap-4 cursor-pointer transition-all duration-500 group hover:border-yellow-500/50">
                <div id="iconBox" class="text-yellow-500 transition-transform duration-500">
                    <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 22v-5l5-5 5 5-5 5z"/><path d="M9.5 14.5L16 8"/><path d="m17 2 5 5-.5.5a3.5 3.5 0 1 1-5-5z"/></svg>
                </div>
                <span id="statusText" class="font-black text-2xl tracking-widest uppercase">Start Mining</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">
                <div class="bg-zinc-900/80 p-8 rounded-3xl border border-yellow-500/10 flex items-center gap-6">
                    <div class="p-4 bg-yellow-500/10 rounded-2xl text-yellow-500">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 font-bold uppercase tracking-widest">Global Rank</p>
                        <p class="text-2xl font-black text-white">#1,240</p>
                    </div>
                </div>
                <div class="bg-zinc-900/80 p-8 rounded-3xl border border-yellow-500/10 flex items-center gap-6">
                    <div class="p-4 bg-yellow-500/10 rounded-2xl text-yellow-500">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 font-bold uppercase tracking-widest">Mining Speed</p>
                        <p class="text-2xl font-black text-white">4.2 MH/s</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        let isMining = false;
        let balance = 1250.45;
        const balanceEl = document.getElementById('balance');
        const btn = document.getElementById('miningBtn');
        const status = document.getElementById('statusText');

        function toggleMining() {
            isMining = !isMining;
            if(isMining) {
                btn.classList.add('mining-animate', 'bg-yellow-500', 'border-yellow-300');
                btn.classList.remove('bg-zinc-900', 'border-zinc-800');
                document.getElementById('iconBox').style.color = 'black';
                status.innerText = "Mining...";
                status.style.color = 'black';
            } else {
                btn.classList.remove('mining-animate', 'bg-yellow-500', 'border-yellow-300');
                btn.classList.add('bg-zinc-900', 'border-zinc-800');
                document.getElementById('iconBox').style.color = '#EAB308';
                status.innerText = "Start Mining";
                status.style.color = 'white';
            }
        }
    </script>
</body>
</html>
